{
  "name": "rrc-peer-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate:config && next build",
    "start": "next start",
    "lint": "next lint",
    "sec:discover": "node scripts/sec/discover.mjs",
    "sec:manifest": "node scripts/sec/manifest.mjs",
    "sec:retrieve": "node scripts/sec/retrieve.mjs",
    "sec:sync": "node scripts/sec/sync.mjs",
    "sec:xbrl": "node scripts/sec/xbrl-fetch.mjs",
    "sec:check": "node scripts/sec/check.mjs",
    "sec:update": "node scripts/sec/update.mjs",
    "sec:validate": "node scripts/sec/validate.mjs",
    "stock-history:import": "python3 scripts/stock-history/import.py",
    "rigs:import": "python3 scripts/rigs/import.py",
    "test": "node --test tests/*.test.cjs && python3 -m unittest tests/test_stock_history_import.py tests/test_rigs_import.py",
    "typecheck": "tsc --noEmit",
    "validate:config": "node scripts/validate-config.mjs",
    "validate": "npm run validate:config && npm run typecheck && npm test"
  },
  "dependencies": {
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "22.7.4",
    "@types/react": "18.3.10",
    "@types/react-dom": "18.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "typescript": "5.6.2"
  }
}
