# Existing dashboard providers
EIA_API_KEY=
FINNHUB_API_KEY=
FMP_KEY=
OIL_PRICE_API=

# SEC EDGAR fair-access policy requires a descriptive User-Agent
# (format: "App/Company contact-email@example.com"). Used by scripts/sec/*
# and, in Phase 2, by the SEC EDGAR news source adapter.
SEC_USER_AGENT=

# News Intelligence (Phase 2+)
# Postgres connection string. DATABASE_URL is the generic convention;
# POSTGRES_URL is what Vercel's Postgres/Neon marketplace integration
# injects -- either name works, DATABASE_URL takes precedence if both are set.
DATABASE_URL=
POSTGRES_URL=

# Shared secret the cron/manual pipeline endpoint checks via
# `Authorization: Bearer $CRON_SECRET`. Required to invoke
# /api/cron/news at all -- there is no unauthenticated path.
CRON_SECRET=

# Phase 3: AI analysis provider (not called during Phase 2).
ANTHROPIC_API_KEY=
